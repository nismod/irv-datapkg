{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "irv-datapkg-schema.json",
  "title": "Dataset metadata",
  "description": "Metadata for one irv-datapkg dataset recipe. The data_* fields describe the T2 datapackage.json resource; 'collections' describes the STAC collection(s) the recipe publishes at T1; 't2' controls per-region extracts. See docs/recipes.md.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "T2 package resource name: directory under data/{ISO3}/"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "dataset_name": {
      "type": "string"
    },
    "data_author": {
      "type": "string"
    },
    "data_title": {
      "type": "string"
    },
    "data_title_long": {
      "type": "string"
    },
    "data_summary": {
      "type": "string"
    },
    "data_citation": {
      "type": "string"
    },
    "data_license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "title",
        "path"
      ]
    },
    "data_origin_url": {
      "type": "string"
    },
    "data_formats": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "collections": {
      "type": "array",
      "minItems": 1,
      "description": "STAC collections (T1 datasets) this recipe produces",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "license",
          "upstream_url",
          "upstream_version",
          "access",
          "dimensions",
          "processing"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$",
            "description": "Dataset id from docs/datasets.csv"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*-r[1-9][0-9]*$",
            "description": "{upstream}-r{N}"
          },
          "title": {
            "type": "string",
            "description": "Default: data_title_long"
          },
          "description": {
            "type": "string",
            "description": "Default: data_summary"
          },
          "citation": {
            "type": "string",
            "description": "Default: data_citation"
          },
          "doi": {
            "type": "string"
          },
          "license": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+-]+$",
            "description": "SPDX identifier, or 'other'/'proprietary'"
          },
          "license_url": {
            "type": "string",
            "description": "Default: data_license.path"
          },
          "upstream_url": {
            "type": "string",
            "minLength": 1
          },
          "upstream_version": {
            "type": "string",
            "minLength": 1
          },
          "access": {
            "enum": [
              "public",
              "private"
            ]
          },
          "dimensions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "Item properties that distinguish variants"
          },
          "processing": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "units": {
            "type": [
              "string",
              "null"
            ],
            "description": "Default raster band unit"
          },
          "nodata": {
            "type": [
              "number",
              "null"
            ],
            "description": "Default raster nodata"
          }
        }
      }
    },
    "t2": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-region T2 extract settings (see src/irv_datapkg/recipes/extracts.py)",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "items": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "filter": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "array"
            ]
          }
        },
        "stem": {
          "type": "string"
        },
        "layer": {
          "type": [
            "string",
            "null"
          ]
        },
        "vector_format": {
          "enum": [
            "gpkg",
            "parquet"
          ]
        },
        "clip": {
          "enum": [
            "bbox",
            "geometry",
            "none"
          ]
        },
        "summary": {
          "type": "boolean"
        },
        "summary_columns": {
          "type": [
            "array",
            "object",
            "null"
          ]
        },
        "baseline_epoch": {
          "type": [
            "integer",
            "null"
          ]
        },
        "exclude_patterns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Regular expressions; items whose id matches any are left out"
        }
      },
      "required": [
        "enabled"
      ]
    }
  },
  "required": [
    "name",
    "description",
    "version",
    "dataset_name",
    "data_author",
    "data_title",
    "data_title_long",
    "data_summary",
    "data_citation",
    "data_license",
    "data_origin_url",
    "data_formats",
    "collections",
    "t2"
  ]
}
